{% extends "base.html.j2" %}
{% block body %}
<h2>Technical Report</h2>

<h3>Discovered Hosts</h3>
<table>
  <tr><th>Address</th><th>Hostname</th><th>Open Services</th></tr>
  {% for h in hosts %}
  <tr>
    <td>{{ h.address }}</td>
    <td>{{ h.hostname or "-" }}</td>
    <td>{% for s in h.services %}{{ s.port }}/{{ s.protocol }} {{ s.name or "" }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
  </tr>
  {% endfor %}
  {% if not hosts %}<tr><td colspan="3">No hosts discovered.</td></tr>{% endif %}
</table>

<h3>Findings</h3>
{% if findings %}
  {% for f in findings %}
  <div class="finding">
    <h4><span class="sev-{{ f.severity }}">{{ f.severity|capitalize }}</span> {{ f.title }}</h4>
    <p class="meta">Asset: {{ f.asset }} &middot; Status: {{ f.status }} &middot; Confidence: {{ f.confidence }}</p>
    {% if f.description %}<p>{{ f.description }}</p>{% endif %}
    {% if f.remediation %}<p><strong>Remediation:</strong> {{ f.remediation }}</p>{% endif %}
  </div>
  {% endfor %}
{% else %}
<p>No findings were identified.</p>
{% endif %}
{% endblock %}
