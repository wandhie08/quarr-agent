# QUARR — Environment Configuration
# Copy this file to .env and fill in your values.
# Legend: [REQUIRED] must be set; others are optional with sensible defaults.

# ============================================================
# LLM Backend  (choose one; auto-detected if QUARR_LLM_BACKEND=auto)
# ============================================================

# Force a backend: auto | openai | ollama   (default: auto)
# QUARR_LLM_BACKEND=auto

# OpenAI (recommended for tool-calling accuracy)
# [REQUIRED if backend resolves to openai]
# OPENAI_API_KEY=sk-proj-your-key-here
# OPENAI_MODEL=gpt-4o-mini                 # default: gpt-4o-mini

# Ollama (local/offline — used when OPENAI_API_KEY is empty)
# OLLAMA_MODEL=WhiteRabbitNeo/WhiteRabbitNeo-2.5-Qwen-2.5-Coder-7B:latest

# ============================================================
# Retry / Resilience
# ============================================================

# QUARR_LLM_TIMEOUT=120.0                   # seconds per LLM request
# QUARR_LLM_MAX_RETRIES=3                   # retry attempts on transient errors
# QUARR_RATE_LIMIT_TPM=60                   # LLM requests per minute
# QUARR_RATE_LIMIT_BURST=10                 # burst capacity
# QUARR_CIRCUIT_BREAKER_THRESHOLD=5         # failures before opening the circuit
# QUARR_CIRCUIT_BREAKER_TIMEOUT=30.0        # seconds before half-open probe
# QUARR_BACKOFF_INITIAL=1.0                 # initial backoff seconds
# QUARR_BACKOFF_MAX=60.0                    # max backoff seconds
# QUARR_BACKOFF_MULTIPLIER=2.0              # exponential multiplier

# ============================================================
# Logging
# ============================================================

# QUARR_LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
# QUARR_LOG_FORMAT=console                  # console | json  (use json in production)

# ============================================================
# Audit
# ============================================================

# QUARR_AUDIT_LOG_PATH=audit.log            # dedicated audit trail file
# QUARR_AUDIT_MAX_BYTES=10485760            # rotate after ~10 MB
# QUARR_AUDIT_BACKUPS=5                      # rotated file count to keep

# ============================================================
# Access Control & Secrets (Phase 4)
# ============================================================

# Secret source: env | vault           (default: env)
# QUARR_SECRET_PROVIDER=env
# QUARR_VAULT_ADDR=https://vault.internal:8200
# QUARR_VAULT_TOKEN=
# QUARR_VAULT_MOUNT=secret

# Session role: viewer | operator | admin  (default: operator)
# QUARR_SESSION_ROLE=operator

# Require confirmation before HIGH/CRITICAL tools. Set true only for
# non-interactive/automated runs.  (default: false = require approval)
# QUARR_AUTO_APPROVE_DANGEROUS=false

# Allow scanning private/loopback ranges.  (default: true)
# QUARR_ALLOW_PRIVATE_TARGETS=true

# Scope limits per engagement.
# QUARR_MAX_TARGETS=256
# QUARR_MAX_RATE_PER_MIN=120

# ============================================================
# Web UI / Auth (Phase 6 professional Web UI)
# ============================================================

# JWT signing secret — CHANGE THIS IN PRODUCTION (use a long random string).
# QUARR_JWT_SECRET=change-me-to-a-long-random-secret
# QUARR_JWT_ACCESS_TTL_MIN=30
# QUARR_JWT_REFRESH_TTL_MIN=1440

# Initial admin account. If password is empty, a random one is generated and
# logged once at startup (WARNING level).
# QUARR_WEB_ADMIN_USER=admin
# QUARR_WEB_ADMIN_PASSWORD=

# CORS allowed origins (comma-separated). Use specific origins in production.
# QUARR_CORS_ORIGINS=*

# Login attempts allowed per minute per client.
# QUARR_LOGIN_RATE_LIMIT=5

# ============================================================
# Threat Intelligence API Keys (optional)
# ============================================================

# VirusTotal — https://virustotal.com (free tier available)
# VIRUSTOTAL_API_KEY=

# AbuseIPDB — https://abuseipdb.com (free tier available)
# ABUSEIPDB_API_KEY=

# Shodan — https://shodan.io (free tier available)
# SHODAN_API_KEY=
